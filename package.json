{
    "name": "mio-ui",
    "version": "0.1.0",
    "description": "A composable UI library for Vue, empowering developers to build their own design systems",
    "author": {
        "name": "TIMEdrasil",
        "email": "Business.Jiahe.Lin@gmail.com"
    },
    "license": "MIT",
    "type": "module",
    "scripts": {
        "eslint-fix": "eslint --fix",
        "serve": "rollup -w -c rollup.dev.config.js",
        "build": "rollup -c rollup.build.config.js",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "library",
        "vue",
        "vue3",
        "ui",
        "mio-ui"
    ],
    "main": "build/mio-ui.cjs.js",
    "module": "build/mio-ui.esm.js",
    "unpkg": "build/mio-ui.umd.js",
    "exports": {
        ".": {
            "import": "./build/mio-ui.esm.js",
            "require": "./build/mio-ui.cjs.js"
        },
        "./styles.css": "./build/mio-ui.css"
    },
    "files": [
        "build",
        "showcase",
        "README.md",
        "README.zh-CN.md",
        "LICENSE"
    ],
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TIMEdrasil/MiO-UI.git"
    },
    "homepage": "https://github.com/TIMEdrasil/MiO-UI#readme",
    "bugs": {
        "url": "https://github.com/TIMEdrasil/MiO-UI/issues"
    },
    "devDependencies": {
        "@babel/core": "^7.24.9",
        "@babel/eslint-parser": "^7.24.8",
        "@babel/preset-env": "^7.24.8",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^26.0.1",
        "@rollup/plugin-eslint": "^9.0.5",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.7",
        "@rollup/plugin-terser": "^0.4.4",
        "@vue/compiler-sfc": "^3.4.31",
        "vue": "^3.4.31",
        "vue-router": "^4.4.3",
        "eslint": "^9.7.0",
        "eslint-plugin-vue": "^9.27.0",
        "rollup": "^4.18.1",
        "rollup-plugin-scss": "^4.0.0",
        "rollup-plugin-serve": "^1.1.1",
        "rollup-plugin-vue": "^6.0.0",
        "sass": "^1.77.8"
    }
}
